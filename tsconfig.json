{
  "compilerOptions": {
    "baseUrl": "./src",
    "module": "esnext",
    "target": "es2019",
    "moduleResolution": "node",
    "noImplicitAny": false,
    "removeComments": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "declaration": true,
    "declarationDir": "dist",
    "skipLibCheck": true,
    "lib": ["dom", "es2019"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
